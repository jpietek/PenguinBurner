include LICENSE
include README.md
include readme-cli.md
include penguin_burner.sh
include packaging/linux/*.desktop
include overlay/native/latency_layer/CMakeLists.txt
include overlay/native/latency_layer/VkLayer_PENGUINBURNER_latency.json.in
include overlay/native/nvapi_shim/nvapi64.def
include overlay/native/nvapi_shim/build.sh
recursive-include docs *.md *.png *.svg
recursive-include packaging/icons *.png *.svg
recursive-include ui/assets *.png
recursive-include tests *.py
recursive-include overlay/native/latency_layer/src *.cpp *.h *.hpp
recursive-include overlay/native/nvapi_shim/src *.cpp
# Rust daemon (penguin-burnerd) crate: ship sources + committed lockfile so a
# `pip install` from the sdist can cargo-build the daemon into the wheel.
include burnerd/Cargo.toml
include burnerd/Cargo.lock
include burnerd/build.rs
recursive-include burnerd/src *.rs
