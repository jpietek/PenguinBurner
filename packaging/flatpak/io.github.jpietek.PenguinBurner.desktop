[Desktop Entry]
Type=Application
Name=PenguinBurner
GenericName=NVIDIA GPU Tuning Tool
Comment=Automatic NVIDIA GPU undervolting and overclocking, with three verified tiers, adaptive per-game profiles for Steam, Lutris, Heroic and Faugus, and an in-game overlay
Exec=penguin-burner
Icon=io.github.jpietek.PenguinBurner
Terminal=false
Categories=Settings;HardwareSettings;Qt;
Keywords=Penguin;Burner;Penguin Burner;PenguinBurner;penguin-burner;pburn;Nvidia;NVIDIA;GPU;Tuning;Undervolt;Undervolting;Overclock;Overclocking;Adaptive;Overlay;Auto-UV;Q2RTX;CUDA;Steam;Lutris;Heroic;Faugus;
StartupNotify=true
StartupWMClass=io.github.jpietek.PenguinBurner
Actions=ToggleOverlay;NextOverlayDetail;SmallerOverlayText;LargerOverlayText;PreviousOverlayPosition;NextOverlayPosition;

[Desktop Action ToggleOverlay]
Name=Toggle overlay
Exec=penguin-burner-cli --overlay-toggle
X-KDE-Shortcuts=Alt+X

[Desktop Action NextOverlayDetail]
Name=Cycle overlay preset
Exec=penguin-burner-cli --overlay-detail-next
X-KDE-Shortcuts=Alt+C

[Desktop Action SmallerOverlayText]
Name=Decrease overlay Scale
Exec=penguin-burner-cli --overlay-scale-down
X-KDE-Shortcuts=Alt+[

[Desktop Action LargerOverlayText]
Name=Increase overlay Scale
Exec=penguin-burner-cli --overlay-scale-up
X-KDE-Shortcuts=Alt+]

[Desktop Action PreviousOverlayPosition]
Name=Previous overlay position
Exec=penguin-burner-cli --overlay-position-prev
X-KDE-Shortcuts=Alt+<

[Desktop Action NextOverlayPosition]
Name=Next overlay position
Exec=penguin-burner-cli --overlay-position-next
X-KDE-Shortcuts=Alt+>
